# ─────────────────────────────────────────────────────────────────────────────
# E-Commerce backend configuration. Copy to apps/backend/.env and fill in.
#   cp .env.example apps/backend/.env
# Everything except TELEGRAM_BOT_TOKEN already works with the default infra from
# docker-compose. The token is only needed to talk to a *real* Telegram bot.
# ─────────────────────────────────────────────────────────────────────────────

# --- Telegram ---------------------------------------------------------------
# Get this from @BotFather in Telegram: /newbot -> copy the token it gives you.
# Leave blank to run the backend in "offline" mode (APIs work, no live bot).
TELEGRAM_BOT_TOKEN=

# The chat the demo "Order #1048" alert is pushed to. After you message your bot
# once, open GET /debug/updates (see README) to find this number.
MERCHANT_CHAT_ID=

# --- Infra (match docker-compose.yml) --------------------------------------
DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5432/ecommerce
REDIS_URL=redis://localhost:6379

# --- HTTP -------------------------------------------------------------------
PORT=3000
# Public base URL of this server (used to build the Mini App button URL and the
# Telebirr webhook callback). For local dev with long-polling, localhost is fine.
PUBLIC_BASE_URL=http://localhost:3000

# --- Payment sandbox --------------------------------------------------------
# The mock Telebirr gateway injects failures so you can SEE the resilience work.
# Probability (0..1) that a payment call times out, and that it hard-fails.
TELEBIRR_TIMEOUT_RATE=0.6
TELEBIRR_FAILURE_RATE=0.1
# Shared secret the mock gateway uses to sign its async webhook callbacks.
TELEBIRR_WEBHOOK_SECRET=telebirr-sandbox-secret
