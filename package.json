{
  "name": "nova-platform",
  "version": "0.1.0",
  "private": true,
  "description": "NOVA — wellness commerce ops layer for Addis Ababa (Telegram merchant interface, resilient payments, offline courier sync)",
  "scripts": {
    "dev": "pnpm --filter @nova/backend dev",
    "build": "pnpm --filter @nova/backend build",
    "migrate": "pnpm --filter @nova/backend migrate",
    "seed:order": "pnpm --filter @nova/backend seed:order",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.10.1"
}
