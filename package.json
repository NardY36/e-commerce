{
  "name": "ecommerce-platform",
  "version": "0.1.0",
  "private": true,
  "description": "E-Commerce — wellness retail ops layer for Addis Ababa (Telegram merchant interface, resilient payments, offline courier sync)",
  "scripts": {
    "dev": "pnpm --filter @ecommerce/backend dev",
    "build": "pnpm --filter @ecommerce/backend build",
    "migrate": "pnpm --filter @ecommerce/backend migrate",
    "seed:order": "pnpm --filter @ecommerce/backend seed:order",
    "demo:payment": "pnpm --filter @ecommerce/backend demo:payment",
    "test": "pnpm --filter @ecommerce/backend test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.10.1"
}
